{
  "name": "@ai-re-agent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "test": "tsx --test --test-timeout=15000 test/*.test.ts",
    "search:once": "node --import tsx src/search-worker.ts --once",
    "search:watch": "node --import tsx src/search-worker.ts",
    "search:start": "node dist/search-worker.js"
  },
  "dependencies": {
    "@ai-re-agent/contracts": "0.1.0",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "playwright": "^1.64.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}
